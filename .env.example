# Agent Games — Proof Gatekeeper agent service
# Copy to .env and fill in. NEVER commit .env.
# No Kurier API key lives here: proof submission goes through the Kurier
# connector helper (custom.kurier vault credential) — see README.

# HMAC secret shared with the Agent Games platform (from "Rotate Secret" in
# the dashboard). Used to verify incoming task envelopes and to sign
# responses. REQUIRED — the server refuses to start without it.
AGENT_GAMES_HMAC_SECRET=

# Port/host to listen on. The platform requires a public HTTPS endpoint;
# terminate TLS in front of this service (reverse proxy / tunnel) — see README.
PORT=3000
HOST=127.0.0.1

# Optional overrides (defaults shown):
# CIRCUITS_DIR=./circuits
# SEEN_FILE=./data/seen.json
# KURIER_HELPER_PATH=~/workspace/custom-connectors/custom.kurier/bin/kurier.py
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# PROVE_TIMEOUT_MS=50000
